# MindCare+ — Variables de entorno
# ────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a ".env" (sin el .example)
#   2. Rellena los valores reales en ese archivo .env
#   3. NUNCA subas el archivo .env a Git — ya está en .gitignore
#   4. En producción (Railway/Render), configura estas variables
#      directamente en el panel de Variables del servicio
# ────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mindcare
DB_USER=root
DB_PASS=

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Genera un valor aleatorio largo: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=cambia_esto_por_un_valor_aleatorio_muy_largo

# ─── Entorno de la aplicación ─────────────────────────────────────────────────
# Valores posibles: "local" | "production"
APP_ENV=local
APP_URL=http://localhost
