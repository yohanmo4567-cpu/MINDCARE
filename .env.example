# MindCare+ — Variables de entorno
# ────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a ".env" (sin el .example)
#   2. Rellena los valores reales en ese archivo .env (especialmente DB_PASS)
#   3. NUNCA subas el archivo .env a Git — ya está en .gitignore
#   4. En producción (Railway), estas variables son inyectadas
#      automáticamente por el servicio MySQL de Railway
# ────────────────────────────────────────────────────────────────────────────

# ─── Base de datos (Railway MySQL) ──────────────────────────────────────────
DB_HOST=mainline.proxy.rlwy.net
DB_PORT=54550
DB_NAME=railway
DB_USER=root
DB_PASS=tu_password_de_railway

# Variables alternativas compatibles nativamente con Railway:
# MYSQLHOST=mainline.proxy.rlwy.net
# MYSQLPORT=54550
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=tu_password_de_railway
# MYSQL_URL=mysql://root:tu_password@mainline.proxy.rlwy.net:54550/railway

# ─── Seguridad ────────────────────────────────────────────────────────────────
SESSION_SECRET=cambia_esto_por_un_valor_aleatorio_muy_largo

# ─── Entorno de la aplicación ─────────────────────────────────────────────────
APP_ENV=production
APP_URL=http://localhost
