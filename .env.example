# MindCare+ — Variables de entorno
# ────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   Configura estos valores como variables de entorno en el servidor.
#   Railway MySQL también puede usar MYSQLHOST, MYSQLPORT, MYSQLDATABASE,
#   MYSQLUSER, MYSQLPASSWORD o MYSQL_URL.
#   No guardes credenciales reales en este archivo ni las subas a Git.
# ────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Genera un valor aleatorio largo: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=

# ─── Entorno de la aplicación ─────────────────────────────────────────────────
# Valores posibles: "local" | "production"
APP_ENV=local
APP_URL=
